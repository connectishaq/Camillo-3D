# Copy this file to .env.local and fill in your own key. .env.local is gitignored.
#
# Google Maps Platform key with the "Map Tiles API" enabled (Photorealistic 3D Tiles).
# Restrict it to HTTP referrers (your domains + http://localhost:5173/*) and to the Map Tiles API only.
# Leave it empty to skip the photoreal city and use the MapLibre map instead.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-platform-key
